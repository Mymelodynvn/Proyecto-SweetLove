PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
SESSION_SECRET=

# --- Base de datos MySQL ---
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=sweetlove
DATABASE_SSL=false

# --- Mercado Pago (Checkout Pro) ---
# Access Token de PRUEBA (panel > Credenciales de prueba; empieza con APP_USR- o TEST-). Es secreto: solo en el backend, nunca en git
MP_ACCESS_TOKEN=
# Clave secreta de webhooks (panel de la aplicación > Webhooks)
MP_WEBHOOK_SECRET=
# Moneda de la cuenta de Mercado Pago (COP Colombia, ARS Argentina, ...)
MP_CURRENCY_ID=COP
# URL pública de la tienda: a donde vuelve el cliente después de pagar
FRONTEND_URL=http://localhost:3000
# URL pública del backend: a donde Mercado Pago envía los avisos (en local déjala vacía)
BACKEND_PUBLIC_URL=

# --- Correo (recuperar contraseña y verificar correo) ---
# Sin ninguna de las opciones = no se envían correos y no se exige verificar el correo.
# Opción 1, puente con Google Apps Script (funciona en Render gratis, donde el SMTP está bloqueado, y no vence).
# Pasos en backend/README.md: script en backend/scripts/correo-apps-script.gs publicado como aplicación web
MAIL_RELAY_URL=
# La misma clave que escribiste en el script (CLAVE)
MAIL_RELAY_SECRET=
# Opción 2, API de Gmail por HTTPS (con la app en modo Prueba el refresh token vence a los 7 días).
# Pasos en backend/README.md: cliente OAuth "Aplicación de escritorio" y luego `npm run gmail:url` y `npm run gmail:token`
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Correo de Gmail que autorizaste (es el remitente)
GMAIL_USER=
# Opción 3, SMTP con Gmail: tu correo y una "contraseña de aplicación" (Cuenta de Google > Seguridad > Verificación en 2 pasos > Contraseñas de aplicaciones).
SMTP_USER=
SMTP_PASSWORD=
# Opcionales: servidor SMTP (por defecto smtp.gmail.com), puerto (465) y remitente (por defecto, SMTP_USER)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM=Sweet Love <tucorreo@gmail.com>
# Alternativa a SMTP: clave de Resend (https://resend.com)
# RESEND_API_KEY=

# Logo de los correos: debe ser una dirección pública (el cliente de correo lo descarga). Vacío = el de la tienda en FRONTEND_URL
# EMAIL_LOGO_URL=

# --- Pedidos ---
# Minutos que un pedido con Mercado Pago espera su pago antes de cancelarse y devolver el stock
ORDER_TTL_MINUTES=30
