{
  "name": "sweet-love-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de Sweet Love (Express + MySQL) con arquitectura MVC.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "db:init": "node scripts/db.js init",
    "db:migrate": "node scripts/db.js migrate",
    "db:status": "node scripts/db.js status",
    "db:baseline": "node scripts/db.js baseline"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-session": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "mysql2": "^3.15.3"
  }
}
